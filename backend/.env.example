# ============================================================
# Healthcare Application — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# --- Application ---
APP_ENV=development          # development | production
APP_NAME="Healthcare App"
APP_VERSION=1.0.0
DEBUG=true

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Security ---
SECRET_KEY=sdfghjkzxcvbnmwertyustyg
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# --- Database (MySQL) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=healthcare_db
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_ROOT_PASSWORD=root

# --- AI / Google Gemini ---
GEMINI_API_KEY=AQ.Ab8RN6JJIIYRAVDb_bjVRKeXGJrbF3TSu0-
AI_MODEL=gemini-3.5-flash
AI_MAX_TOKENS=1024

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1

# --- File Uploads ---
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=uploads
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png

# --- CORS ---
# Use * to allow all origins, or comma-separated list: http://localhost:5173,https://myapp.com
CORS_ORIGINS=*

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- Redis (optional, for session/cache) ---
# REDIS_URL=redis://localhost:6379/0
